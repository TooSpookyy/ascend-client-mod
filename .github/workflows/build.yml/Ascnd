
name: Build ASCEND Mod

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Prepare Fabric project
        run: |
          mkdir -p src/main/java/com/ascend/client
          mkdir -p src/main/resources

          cp AscendClient.java src/main/java/com/ascend/client/
          cp AscendData.java src/main/java/com/ascend/client/
          cp AscendScreen.java src/main/java/com/ascend/client/

          cat > settings.gradle <<'EOF'
          pluginManagement {
              repositories {
                  maven { url = 'https://maven.fabricmc.net/' }
                  gradlePluginPortal()
                  mavenCentral()
              }
          }
          rootProject.name = 'ascend-client-mod'
          EOF

          cat > gradle.properties <<'EOF'
          org.gradle.jvmargs=-Xmx2G
          minecraft_version=1.21.11
          yarn_mappings=1.21.11+build.1
          loader_version=0.18.1
          fabric_version=0.141.1+1.21.11
          mod_version=1.0.0
          maven_group=com.ascend
          archives_base_name=ascend-client
          EOF

          cat > build.gradle <<'EOF'
          plugins {
              id 'fabric-loom' version '1.13-SNAPSHOT'
          }
          version = project.mod_version
          group = project.maven_group
          base { archivesName = project.archives_base_name }
          repositories {
              maven { url = 'https://maven.fabricmc.net/' }
              mavenCentral()
          }
          dependencies {
              minecraft "com.mojang:minecraft:${project.minecraft_version}"
              mappings "net.fabricmc:yarn:${project.yarn_mappings}:v2"
              modImplementation "net.fabricmc:fabric-loader:${project.loader_version}"
              modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_version}"
          }
          java {
              toolchain { languageVersion = JavaLanguageVersion.of(21) }
          }
          processResources {
              inputs.property 'version', project.version
              filesMatching('fabric.mod.json') {
                  expand 'version': project.version
              }
          }
          EOF

          cat > src/main/resources/fabric.mod.json <<'EOF'
          {
            "schemaVersion": 1,
            "id": "ascend",
            "version": "${version}",
            "name": "ASCEND Client",
            "description": "ASCEND client utility mod",
            "environment": "client",
            "entrypoints": {
              "client": ["com.ascend.client.AscendClient"]
            },
            "depends": {
              "fabricloader": ">=0.16.0",
              "minecraft": "~1.21.11",
              "java": ">=21",
              "fabric-api": "*"
            }
          }
          EOF

      - name: Build mod
        run: gradle build --no-daemon

      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: ASCEND-Mod
          path: build/libs/*.jar
